<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>速算對決</title>
  <link rel="icon" href="favicon.ico" type="image/x-icon">
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background: radial-gradient(circle at top left, #0f2027, #203a43, #2c5364);
      color: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }
    h1 {
      font-size: 2.5em;
      margin-top: 1em;
      margin-bottom: 0.3em;
    }
    #home, #game {
      display: none;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }
    #home.active, #game.active {
      display: flex;
    }
    #history {
      font-size: 1em;
      margin: 1em 0;
      color: #ccc;
    }
    #question {
      font-size: 3em;
      background: #1c1c1c;
      border-radius: 15px;
      padding: 20px 40px;
      margin-bottom: 20px;
      box-shadow: 0 0 10px rgba(0, 255, 255, 0.4);
    }
    #info {
      font-size: 1.2em;
      margin-bottom: 20px;
    }
    .num-buttons {
      display: grid;
      grid-template-columns: repeat(3, 80px);
      gap: 15px;
      justify-content: center;
      margin-bottom: 30px;
    }
    .btn {
      font-size: 1.8em;
      background-color: #00d1ff;
      border: none;
      border-radius: 10px;
      width: 70px;
      height: 70px;
      color: #000;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn:active {
      transform: scale(0.95);
      background-color: #00a3cc;
    }
    .end {
      color: #ff6666;
      font-size: 1.5em;
    }
    .start-btn {
      font-size: 1.2em;
      padding: 10px 20px;
      border: none;
      border-radius: 10px;
      background: #00ffcc;
      color: #000;
      cursor: pointer;
      margin-top: 20px;
    }
    footer {
      margin-top: auto;
      font-size: 0.8em;
      color: #999;
      padding-top: 20px;
    }
  </style>
</head>
<body>
  <h1>速算對決</h1>
  <div id="home" class="active">
    <p>遊戲說明：你有 30 秒時間，盡可能多地回答正確的加減法題目（答案僅限 1~9）。</p>
    <div id="history">近期答對紀錄：--｜--｜--｜最佳：--</div>
    <button class="start-btn" onclick="showGame()">開始遊戲</button>
  </div>

  <div id="game">
    <div id="question">請按任一數字鍵開始</div>
    <div id="info">剩餘時間：30 秒｜答對：0 題</div>
    <div class="num-buttons">
      <button class="btn">1</button>
      <button class="btn">2</button>
      <button class="btn">3</button>
      <button class="btn">4</button>
      <button class="btn">5</button>
      <button class="btn">6</button>
      <button class="btn">7</button>
      <button class="btn">8</button>
      <button class="btn">9</button>
    </div>
  </div>
  <footer>© 2025 速算對決</footer>

  <script>
    let timeLeft = 30;
    let correctCount = 0;
    let currentAnswer = 0;
    let timer;
    let gameStarted = false;
    let history = JSON.parse(localStorage.getItem("history") || "[]");

    const maxRecord = () => Math.max(...history, 0);

    const questionEl = document.getElementById("question");
    const infoEl = document.getElementById("info");
    const historyEl = document.getElementById("history");
    const buttons = document.querySelectorAll(".btn");
    const homeEl = document.getElementById("home");
    const gameEl = document.getElementById("game");

    function updateHistoryDisplay() {
      const recent = [...history].slice(-3).reverse().map(v => `${v} 題`).join("｜") || "--";
      historyEl.textContent = `近期答對紀錄：${recent}｜最佳：${maxRecord()} 題`;
    }

    function generateQuestion() {
      const isAddition = Math.random() > 0.5;
      let a = Math.floor(Math.random() * 9) + 1;
      let b = Math.floor(Math.random() * 9) + 1;
      if (!isAddition && a < b) [a, b] = [b, a];
      currentAnswer = isAddition ? a + b : a - b;
      if (currentAnswer < 1 || currentAnswer > 9) {
        generateQuestion();
        return;
      }
      questionEl.textContent = `${a} ${isAddition ? "+" : "-"} ${b} = ?`;
    }

    function showGame() {
      homeEl.classList.remove("active");
      gameEl.classList.add("active");
      updateHistoryDisplay();
    }

    function startGame() {
      correctCount = 0;
      timeLeft = 30;
      gameStarted = true;
      generateQuestion();
      infoEl.textContent = `剩餘時間：${timeLeft} 秒｜答對：${correctCount} 題`;

      timer = setInterval(() => {
        timeLeft--;
        infoEl.textContent = `剩餘時間：${timeLeft} 秒｜答對：${correctCount} 題`;
        if (timeLeft <= 0) {
          clearInterval(timer);
          history.push(correctCount);
          history = history.slice(-10);
          localStorage.setItem("history", JSON.stringify(history));
          questionEl.innerHTML = `<span class='end'>時間到！你答對了 ${correctCount} 題！</span>`;
          updateHistoryDisplay();
          gameStarted = false;
        }
      }, 1000);
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const answer = parseInt(btn.textContent);
        if (!gameStarted) {
          startGame();
          return;
        }
        if (answer === currentAnswer) {
          correctCount++;
        }
        generateQuestion();
        infoEl.textContent = `剩餘時間：${timeLeft} 秒｜答對：${correctCount} 題`;
      });
    });

    updateHistoryDisplay();
  </script>
</body>
</html>
